{
  "extends": "../tsconfig.base.json",
  "compilerOptions": {
    "target": "ES2022",
    "lib": [
      "dom",
      "dom.iterable",
      "ES2022"
    ],
    "module": "esnext",
    "moduleResolution": "bundler",
    "allowJs": false,
    "noEmit": true,
    "declaration": false,
    "sourceMap": false,
    "jsx": "preserve",
    "isolatedModules": true,
    "paths": {
      "@/*": [
        "./src/*"
      ],
      "@control-plane-eck/shared": [
        "../packages/shared/src"
      ],
      "@control-plane-eck/shared/*": [
        "../packages/shared/src/*"
      ]
    },
    "plugins": [
      {
        "name": "next"
      }
    ],
    "incremental": true
  },
  "include": [
    "next-env.d.ts",
    "**/*.ts",
    "**/*.tsx",
    ".next/types/**/*.ts"
  ],
  "exclude": [
    "node_modules",
    ".next",
    "out"
  ]
}
