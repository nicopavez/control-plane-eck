# Copy to .env and fill in real values. .env is gitignored; never commit it.

# Path to the kubeconfig pointing at your local minikube cluster.
# On Windows with minikube this is usually: C:\Users\<you>\.kube\config
KUBECONFIG=~/.kube/config

# Namespace and Elasticsearch resource name the API/TUI target.
ES_NAMESPACE=default
ES_CLUSTER_NAME=quickstart

# Port the Fastify API listens on. The TUI and web stub call this.
API_PORT=4000
API_BASE_URL=http://localhost:4000

# pino log level for packages/api: fatal | error | warn | info | debug | trace
LOG_LEVEL=info

# Local port packages/api uses for its own `kubectl port-forward` to the
# Elasticsearch HTTP service (ES itself listens on 9200 inside the
# cluster; this is a separate local port so it never collides with that).
# Optional: defaults to 9201 if unset.
ES_LOCAL_PORT=9201
