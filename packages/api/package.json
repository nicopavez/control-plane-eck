{
  "name": "@control-plane-eck/api",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "main": "./dist/server.js",
  "scripts": {
    "prebuild": "npm run build -w @control-plane-eck/shared --if-present",
    "build": "tsc -p tsconfig.json",
    "pretypecheck": "npm run build -w @control-plane-eck/shared --if-present",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "lint": "eslint src --max-warnings 0",
    "pretest": "npm run build -w @control-plane-eck/shared --if-present",
    "test": "vitest run",
    "predev": "npm run build -w @control-plane-eck/shared --if-present",
    "dev": "tsx watch src/server.ts",
    "start": "node dist/server.js"
  },
  "dependencies": {
    "@control-plane-eck/shared": "*",
    "@fastify/cors": "^10.1.0",
    "@kubernetes/client-node": "^2.0.1",
    "dotenv": "^18.0.9",
    "fastify": "^5.12.7",
    "pino": "^10.4.0",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@types/node": "^26.6.5",
    "tsx": "^4.23.15",
    "typescript": "^5.7.2",
    "vitest": "^3.2.4"
  }
}
