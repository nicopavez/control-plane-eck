{
  "name": "@control-plane-eck/tui",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Ink terminal client for the ECK control plane. Scale, upgrade and manage indices without YAML or kubectl.",
  "bin": {
    "control-plane-tui": "./dist/cli.js"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "lint": "eslint src --max-warnings 0",
    "dev": "tsx src/cli.tsx",
    "start": "node dist/cli.js"
  },
  "dependencies": {
    "@control-plane-eck/shared": "*",
    "chalk": "^5.6.2",
    "dotenv": "^18.0.9",
    "ink": "^6.8.0",
    "ink-select-input": "^6.2.0",
    "ink-spinner": "^5.0.0",
    "ink-text-input": "^6.0.0",
    "react": "^19.3.1"
  },
  "devDependencies": {
    "@types/node": "^26.6.5",
    "@types/react": "^19.3.0",
    "@typescript-eslint/eslint-plugin": "^8.18.0",
    "@typescript-eslint/parser": "^8.18.0",
    "eslint": "^9.17.0",
    "eslint-config-prettier": "^9.1.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "tsx": "^4.23.15",
    "typescript": "^5.7.2",
    "react-devtools-core": "^6.1.5"
  },
  "engines": {
    "node": ">=20"
  }
}